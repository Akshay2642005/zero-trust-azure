# --- Terraform ---

# Local provider/module cache and backend metadata
**/.terraform/*
.terraform/
.terraform.tfstate.lock.info

# State files (may contain secrets). Use a remote backend instead of committing.
*.tfstate
*.tfstate.*

# Crash logs
crash.log
crash.*.log

# Saved plans
*.tfplan
*.tfplan.json
plans/

# Variable files (may contain secrets). Keep the committed *.example files.
*.tfvars
*.tfvars.json
!*.tfvars.example
!*.tfvars.json.example

# CLI configuration
.terraformrc
terraform.rc

# Local override files
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# NOTE: the dependency lock file (.terraform.lock.hcl) is intentionally NOT
# ignored — commit it so every run resolves the exact same provider versions.
.DS_Store
